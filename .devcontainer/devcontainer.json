{
  "name": "our-mahjong-history",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "initializeCommand": "printf 'LOCAL_WORKSPACE_FOLDER=%s\\n' '${localWorkspaceFolder}' > '${localWorkspaceFolder}/.devcontainer/.env'",
  "containerEnv": {
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "postCreateCommand": "bash -lc 'if [ -f web/package.json ]; then cd web && npm install; fi'",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "remote.autoForwardPorts": false,
        "remote.restoreForwardedPorts": false
      }
    }
  }
}
